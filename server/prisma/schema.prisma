generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockStatus {
  OPENING_STOCK
  WAITING_FOR_RESTOCK
  ACTIVE
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  category    String
  stock       Int
  price       Float
  stockStatus StockStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  action      String
  productName String
  details     String?
  createdAt   DateTime @default(now())
}

model Sale {
  id            Int      @id @default(autoincrement())
  productName   String
  quantity      Int
  unitPrice     Float
  totalAmount   Float
  paymentMethod String
  receiptNumber String   @unique
  createdAt     DateTime @default(now())
}